# ==============================================================================
# LeaseOps Environment Configuration (.env.example)
# ==============================================================================
# This is the template environment configuration file for LeaseOps.
# 
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the root of the workspace:
#    cp .env.example .env
# 2. Fill out the required environment variables below according to your local
#    development setup or self-hosted deployment environment.
# 
# SECURITY WARNING:
# 🚫 Never commit `.env` to version control! All sensitive keys (OpenAI, DeepSeek,
#    webhook secrets) must be loaded securely via Bun.env / process.env and must
#    never be exposed to frontend client bundles (unless explicitly prefixed with
#    VITE_, which should only be used for non-sensitive public URLs).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------

# NODE_ENV
# Defines the execution environment for the Hono backend and Drizzle ORM.
# - "development": Enables verbose logging, auto-running Drizzle database migrations
#                  on startup, HMR Hono debugging, and detailed stack traces.
# - "production":  Enables strict performance optimizations, Hono production logging,
#                  and disables automatic development database migrations.
# - "test":        Used by `bun test` for isolated unit and integration testing.
# Default: development
NODE_ENV=development

# PORT
# The TCP port on which the Hono REST API server will listen.
# Note: In local development, Vite (port 5173) is configured to automatically proxy
# `/api` requests to this port. If you change this port, update `vite.config.ts`.
# Default: 3000
PORT=3000



# ------------------------------------------------------------------------------
# 2. DATABASE & STORAGE (Drizzle ORM + SQLite)
# ------------------------------------------------------------------------------

# DATABASE_URL
# The file path to the embedded SQLite database file (`bun:sqlite`).
#
# CRITICAL MONOREPO RULE (Single Source of Truth):
# To prevent creating duplicate or fragmented `.db` files across the monorepo,
# ALWAYS point this to the shared database package when developing locally!
#
# - For Local Development (Host OS):
#   Use `./packages/db/local_leaseops.db` so that `bun run db:migrate`, `db:studio`,
#   `apps/api`, and `apps/web` all read and write to the exact same database file.
#
# - For Docker Compose Container Deployment:
#   Set this to `/app/data/local_leaseops.db`. In `docker-compose.yml`, the directory
#   `/app/data` is mounted to a persistent Docker named volume (`leaseops_data`),
#   ensuring your leads, survey responses, and MCDA scores survive container restarts.
#
# Default (Local): ./packages/db/local_leaseops.db
DATABASE_URL=./packages/db/local_leaseops.db


# ------------------------------------------------------------------------------
# 3. AI & LLM SERVICES (OpenAI / DeepSeek)
# ------------------------------------------------------------------------------
# LeaseOps integrates LLM workers to perform automated RevOps/MarOps workflows:
# 1. Drafting personalized, localized outreach messages in the landlord's native
#    language for listings that achieve a qualifying MCDA score (MQLs).
# 2. Generating AI Compromise Summaries (bluntly stating what sacrifices or
#    trade-offs the tenant makes by choosing a specific unit).
#
# Note: All raw scraped listing text is automatically wrapped in `<UNTRUSTED_LISTING_CONTENT>`
# XML boundaries to prevent adversarial prompt injection from external portals.

# OPENAI_API_KEY
# Your OpenAI API key (used for GPT-4o / GPT-4o-mini models).
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Leave blank if exclusively using DeepSeek or local fallback stubs.
OPENAI_API_KEY=

# DEEPSEEK_API_KEY
# Your DeepSeek API key (used for DeepSeek-V3 / DeepSeek-R1 reasoning models).
# DeepSeek provides highly cost-effective reasoning for mathematical lead scoring
# explanations and bilingual outreach drafting.
# Format: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# If both OPENAI_API_KEY and DEEPSEEK_API_KEY are blank, every LLM feature falls
# back to a deterministic offline generator that derives its output from the
# scraped listing data. The app stays fully usable; the wording is just simpler.
DEEPSEEK_API_KEY=

# DEEPSEEK_MODEL
# Model identifier used for listing extraction, outreach drafting, chat reply
# suggestions, and compromise summaries.
# Default: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# DEEPSEEK_REVIEW_MODEL
# Optional override used only for generating the AI Review of a qualified lead,
# where a stronger reasoning model can be worth the extra cost.
# Falls back to DEEPSEEK_MODEL when unset.
# Example: deepseek-reasoner
DEEPSEEK_REVIEW_MODEL=


# ------------------------------------------------------------------------------
# 4. SCRAPING & ENRICHMENT PIPELINE
# ------------------------------------------------------------------------------
# Configuration for background asynchronous queues that ingest apartment listing
# URLs, scrape description text, and extract pricing/amenities for MCDA scoring.

# SCRAPFLY_API_KEY
# API key for Scrapfly Anti-Bot Bypass API (https://scrapfly.io).
# Used to bypass DataDome and enterprise WAF challenges on heavily protected portals
# like Idealista by enabling Anti-Scraping Protection (ASP) and headless JS rendering.
# Acts as a secure pipe: URL in -> Scrapfly Bypass -> Raw HTML directly to Database.
#
# Without this key, adding a listing will fail at the scraping step and the
# listing is saved with status ERROR. `SCRAPFLY_KEY` is accepted as an alias.
SCRAPFLY_API_KEY=


# ------------------------------------------------------------------------------
# 5. FRONTEND PWA & CORS CONFIGURATION
# ------------------------------------------------------------------------------

# CORS_ALLOWED_ORIGINS
# Comma-separated list of allowed origin URLs for CORS (Cross-Origin Resource Sharing).
# In production, restrict this to your exact PWA domain name.
# Default: http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Note: the web client currently calls the API on a relative `/api` path only.
# In development Vite proxies that to PORT above; in production serve the built
# PWA behind the same origin as the API, or add a reverse-proxy rule for `/api`.


# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# LeaseOps is a self-hosted, single-tenant Progressive Web App.
# Define your login credentials below. When you spin up the Docker Compose
# container or run locally via `bun run dev`, the PWA login screen will validate
# against these credentials before granting access to the RevOps command center.

# AUTH_USERNAME
# The username required to log into the LeaseOps frontend and access API endpoints.
# Default: admin
AUTH_USERNAME=admin

# AUTH_PASSWORD
# The password required to log into the LeaseOps frontend and access API endpoints.
# Default: leaseops
AUTH_PASSWORD=leaseops

