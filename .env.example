# LeaseOps environment. Copy to `.env` and fill in.
# `.env` is gitignored. Keep it that way — never commit it.

# development | production | test
# In development the schema auto-migrates on first connection; production does
# not, so deployments must run `bun run db:migrate` explicitly.
NODE_ENV=development

# API port. Vite proxies /api here from :5173 — change this and update vite.config.ts.
PORT=3000

# Resolved relative to the process working directory, so running a script from
# the wrong directory silently creates a second, empty database instead of
# failing. If data seems to vanish, check which file you actually opened.
# Docker: /app/data/local_leaseops.db (mounted to the leaseops_data volume).
DATABASE_URL=./packages/db/local_leaseops.db

# NOT read at runtime. The Anthropic key lives per household, set in the app under
# Settings → AI & billing, so the member who adds it is the one paying and two
# households on one server never share a credential.
#
# This variable is kept for one purpose: if it is set, Settings offers a one-click
# import of it into your household. That is a migration convenience, not a
# fallback — once imported, only the stored key is ever used. Leave it blank on a
# fresh install and add the key in the app instead.
#
# Without a household key the app is fully functional: every LLM feature falls
# back to a deterministic offline generator. Nothing is invented in either mode.
ANTHROPIC_API_KEY=

# Removed. The model is a per-household setting next to the key, since it is the
# cost lever for whoever is paying. Setting it here does nothing.
# ANTHROPIC_MODEL=

# Restrict to your exact domain in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# No credentials here by design: accounts live in the database and you create
# the first one from the app's sign-up screen. See the README for the household
# model and for why there is no password reset.
