{
  "name": "@leaseops/root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '!@leaseops/root' dev",
    "build": "bun run --filter '!@leaseops/root' build",
    "test": "bun test",
    "typecheck": "bun run --filter '!@leaseops/root' typecheck",
    "db:generate": "bun run --filter @leaseops/db generate",
    "db:migrate": "bun run --filter @leaseops/db migrate",
    "db:studio": "bun run --filter @leaseops/db studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
